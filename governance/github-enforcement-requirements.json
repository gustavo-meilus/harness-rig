{
  "schema": "harness-rig/github-enforcement-requirements/v1",
  "required_repository_verdict": {
    "check_name": "ci / required",
    "expected_source": "GitHub Actions",
    "live_source_binding": "repository-or-organization-ruleset-required",
    "subjects": [
      "pull_request",
      "merge_group",
      "push",
      "workflow_dispatch"
    ]
  },
  "workflow_integrity": "candidate-controlled; required check is project CI evidence, not an independent acceptance oracle",
  "fork_pull_request": {
    "workflow_event": "pull_request",
    "workflow_token_permissions": "contents:read",
    "privileged_actions_allowed": false,
    "pull_request_target_for_untrusted_code": false,
    "repository_setting_must_not_send_secrets_or_write_tokens_to_untrusted_forks": true
  },
  "merge_queue": {
    "event": "merge_group",
    "activity": "checks_requested"
  },
  "qualification": "local-contract-only-until-installed-repository-settings-are-observed"
}
